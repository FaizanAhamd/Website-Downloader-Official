# ============================================================
# Website Downloader — Example Environment Variables
# ============================================================
# Copy this file to `.env` for local development.
# Add real production values through Vercel Environment Variables
# or your worker hosting provider's environment settings.
#
# NEVER commit `.env` or real credentials to GitHub.
# ============================================================


# ------------------------------------------------------------
# HTTP SERVER
# ------------------------------------------------------------

PORT=3000


# ------------------------------------------------------------
# PUBLIC BRANDING
# ------------------------------------------------------------

PUBLIC_PRODUCT_NAME=Website Downloader
PUBLIC_PRODUCT_OWNER=Faizan Ahmad
PUBLIC_GITHUB_URL=https://github.com/FaizanAhamd/Website-Downloader-Official

PUBLIC_CONTACT_EMAIL=sweetychadhury01@gmail.com
PUBLIC_BUSINESS_ADDRESS=


# ------------------------------------------------------------
# PUBLIC WEBSITE URL
# ------------------------------------------------------------

# Set this after deploying your website to Vercel.
# Example: https://your-project.vercel.app

PUBLIC_SITE_URL=


# ------------------------------------------------------------
# DOWNLOAD ENGINE
# ------------------------------------------------------------

DOWNLOAD_QUOTA=100m
DOWNLOAD_TIMEOUT_MS=300000
DOWNLOAD_WATCHDOG_MS=2000
MAX_CONCURRENT_DOWNLOADS=5
DOWNLOAD_ZIP_TTL_HOURS=24

# Optional: Override the Wget executable path.
# Example Windows: C:\path\to\wget.exe

WGET_PATH=


# ------------------------------------------------------------
# VERCEL APPLICATION — EXTERNAL WORKER
# ------------------------------------------------------------

# Set these in Vercel Project Settings → Environment Variables.
# Do not expose WORKER_API_KEY to frontend JavaScript.

WORKER_URL=
WORKER_API_KEY=

# Comma-separated explicitly trusted proxy IPs/CIDRs.
# Configure only if required by your actual hosting architecture.
TRUST_PROXY=


# ------------------------------------------------------------
# WORKER SERVER
# ------------------------------------------------------------

# Configure these on your separate always-on worker host.
# Use the same WORKER_API_KEY as configured in Vercel.

WORKER_CORS_ORIGIN=
WORKER_PORT=3001

# Enable durable ZIP storage using your storage integration.
ARCHIVE_UPLOAD_URL=


# ------------------------------------------------------------
# GOOGLE ADSENSE
# ------------------------------------------------------------

# Keep advertising disabled until your real AdSense account,
# publisher ID and ad-unit slot IDs are verified.

ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_ID=


# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------

# Configure your actual S3-compatible storage integration
# through the worker hosting provider.
# Never put storage credentials in this example file.

ZIP_STORAGE_BUCKET=
ZIP_STORAGE_REGION=
ZIP_STORAGE_ENDPOINT=


# ============================================================
# END OF EXAMPLE CONFIGURATION
# ============================================================