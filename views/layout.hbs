<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{title}}</title>
  <meta name="description" content="{{meta.description}}" />
  <meta name="author" content="{{config.brand.owner}}" />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph + Twitter Card (canonical only when a real public domain is configured) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{config.brand.name}}" />
  <meta property="og:title" content="{{title}}" />
  <meta property="og:description" content="{{meta.description}}" />
  <meta property="og:image" content="{{#if config.brand.siteUrl}}{{config.brand.baseUrl}}/favicon.svg{{/if}}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{title}}" />
  <meta name="twitter:description" content="{{meta.description}}" />
  {{#if config.brand.siteUrl}}
  <meta property="og:url" content="{{config.brand.baseUrl}}{{meta.canonical}}" />
  <link rel="canonical" href="{{config.brand.baseUrl}}{{meta.canonical}}" />
  {{/if}}

  <!-- Structured data: WebSite + SoftwareApplication (only when a domain is configured) -->
  {{#if config.brand.siteUrl}}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{config.brand.name}}",
    "url": "{{config.brand.baseUrl}}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{config.brand.baseUrl}}/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "{{config.brand.name}}",
    "applicationCategory": "WebApplication",
    "operatingSystem": "Web",
    "url": "{{config.brand.baseUrl}}",
    "description": "{{meta.description}}",
    "publisher": {
      "@type": "Organization",
      "name": "{{config.brand.owner}}"
    }
  }
  </script>
  {{/if}}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="/stylesheets/pages.css" />

  {{#if config.adsense.scriptEnabled}}
  <!-- Google AdSense loader (only injected when verified & enabled via env) -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{config.adsense.clientId}}" crossorigin="anonymous"></script>
  {{/if}}

  {{#if config.ga.measurementId}}
  <!-- Google Analytics 4 — loaded asynchronously, only when GA_MEASUREMENT_ID is set.
       Consent Mode v2: analytics storage is denied by default until the visitor
       accepts in the consent banner. Rejecting keeps analytics disabled. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'functionality_storage': 'granted',
      'personalization_storage': 'denied',
      'security_storage': 'granted',
      'wait_for_update': 500
    });
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0];
      var j = d.createElement(s);
      var dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtag/js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', '{{config.ga.measurementId}}');
    gtag('js', new Date());
    gtag('config', '{{config.ga.measurementId}}');
  </script>
  {{/if}}
</head>
<body>

  <!-- ============ HEADER ============ -->
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Website Downloader home">
        <svg class="brand-mark" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8V5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v3" />
          <path d="M3 16v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3" />
          <path d="M12 12v8" />
          <path d="M8.5 14.5L12 11l3.5 3.5" />
        </svg>
        <span class="brand-name">{{config.brand.name}}</span>
      </a>

      <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="primary-nav" aria-expanded="false">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/features">Features</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/guides">Guides</a>
        <a href="/faq">FAQ</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a class="btn btn-primary btn-sm" href="/#downloader">Start Downloading</a>
      </nav>
    </div>
  </header>

  <main>
    {{{body}}}
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <p class="footer-heading">{{config.brand.name}}</p>
        <p>Mirror publicly accessible websites and download their pages and static resources as a ZIP archive.</p>
        <p class="muted">Maintained by {{config.brand.owner}}.</p>
        <p class="muted">
          <a href="{{config.brand.githubUrl}}" target="_blank" rel="noopener noreferrer">GitHub repository</a>
        </p>
      </div>
      <div>
        <p class="footer-heading">Explore</p>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/features">Features</a></li>
          <li><a href="/how-it-works">How It Works</a></li>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-heading">Legal</p>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="{{config.brand.githubUrl}}/blob/main/LICENSE.md" target="_blank" rel="noopener noreferrer">MIT License</a></li>
          <li><a href="{{config.brand.githubUrl}}/blob/main/THIRD_PARTY_NOTICES.md" target="_blank" rel="noopener noreferrer">Third-Party Notices</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© {{config.brand.owner}}. Released under the MIT License.</p>
      <p class="muted">Mirrors only publicly accessible static resources. Content is downloaded for personal, authorized use only.</p>
    </div>
  </footer>

  <!-- ============ SCRIPTS ============ -->
  <script>
    window.WD_API_BASE = "{{config.apiBaseUrl}}";
    window.WD_WORKER_PROXY = {{#if config.worker.enabled}}true{{else}}false{{/if}};
  </script>
  {{#unless config.worker.enabled}}
  <!-- Classic Wget + Socket.IO mode (default). The Socket.IO client is only
       needed here; in worker-proxy mode the downloader uses HTTP polling and
       the Socket.IO client would 404 on Vercel (no Socket.IO server). -->
  <script src="/socket.io/socket.io.js"></script>
  {{/unless}}
  <script src="/js/downloader.js" defer></script>
  <script>
    // Accessible mobile navigation toggle (no dependencies)
    (function () {
      var btn = document.getElementById('nav-toggle');
      var nav = document.getElementById('primary-nav');
      if (!btn || !nav) return;
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.classList.toggle('active', open);
      });
      // Close the menu when a link is chosen (mobile).
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('open');
          btn.classList.remove('active');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    })();
  </script>

  {{#if config.ga.measurementId}}
  <!-- Analytics consent banner (Google Consent Mode v2). Only rendered when GA4
       is configured. No analytics storage is used until the visitor explicitly
       accepts; rejecting disables analytics tracking. -->
  <div id="consent-banner" role="dialog" aria-live="polite" aria-label="Analytics consent"
       style="position:fixed;left:0;right:0;bottom:0;z-index:9999;background:#0b1f3a;color:#fff;padding:14px 20px;font-size:14px;display:none;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;box-shadow:0 -2px 12px rgba(0,0,0,.2);">
    <span style="max-width:720px;">
      This site uses Google Analytics to understand how visitors use it. Analytics
      cookies and identifiers are only used if you accept.
      <a href="/privacy" style="color:#7fb3ff;text-decoration:underline;">Privacy Policy</a>.
    </span>
    <span style="display:flex;gap:10px;">
      <button type="button" id="consent-reject"
              style="background:transparent;color:#fff;border:1px solid #7fb3ff;border-radius:8px;padding:8px 16px;cursor:pointer;">Reject</button>
      <button type="button" id="consent-accept"
              style="background:#2563eb;color:#fff;border:none;border-radius:8px;padding:8px 16px;cursor:pointer;font-weight:600;">Accept</button>
    </span>
  </div>
  <script>
    (function () {
      if (typeof gtag !== 'function') return; // GA not configured
      var KEY = 'wd_analytics_consent';
      var banner = document.getElementById('consent-banner');
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) { saved = null; }
      function applyConsent(state) {
        if (state === 'granted') {
          gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted',
            'functionality_storage': 'granted',
            'personalization_storage': 'granted',
            'security_storage': 'granted'
          });
        } else {
          gtag('consent', 'update', {
            'ad_storage': 'denied',
            'analytics_storage': 'denied',
            'functionality_storage': 'granted',
            'personalization_storage': 'denied',
            'security_storage': 'granted'
          });
        }
      }
      function showBanner() { if (banner) banner.style.display = 'flex'; }
      function hideBanner() { if (banner) banner.style.display = 'none'; }
      function choose(state) {
        applyConsent(state);
        try { localStorage.setItem(KEY, state); } catch (e) {}
        hideBanner();
      }
      if (saved === 'granted') { applyConsent('granted'); }
      else if (saved === 'denied') { applyConsent('denied'); }
      else { showBanner(); }
      if (banner) {
        var accept = document.getElementById('consent-accept');
        var reject = document.getElementById('consent-reject');
        if (accept) accept.addEventListener('click', function () { choose('granted'); });
        if (reject) reject.addEventListener('click', function () { choose('denied'); });
      }
    })();
  </script>
  {{/if}}
</body>
</html>
