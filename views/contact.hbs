<section class="section page-hero">
  <div class="container container-narrow">
    <div class="section-head">
      <span class="badge badge-primary">Contact</span>
      <h1>Contact Us</h1>
      <p>Questions, feedback, or feature ideas — reach out.</p>
    </div>

    {{#if composed}}
    <div class="card contact-success">
      <h2>Your message is ready to send</h2>
      <p>
        We don't send email from this site. Click below to open your own email
        app addressed to <strong>{{contactEmail}}</strong> with your message already
        written — just press send there.
      </p>
      <p style="margin-top:1.25rem">
        <a class="btn btn-primary" href="{{mailto}}">Open your email app</a>
      </p>
      <p class="muted">Nothing has been sent yet. You send it from your email account.</p>
    </div>
    {{else}}
    <div class="card contact-form-card">
      {{#if error}}
      <p class="field-error" role="alert">{{error}}</p>
      {{/if}}
      <form id="contact-form" method="post" action="/contact" novalidate>
        <div class="field">
          <label for="cf-name">Name</label>
          <input type="text" id="cf-name" name="name" value="{{values.name}}" required />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input type="email" id="cf-email" name="email" value="{{values.email}}" required />
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" required>{{values.message}}</textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">Prepare message</button>
        <p class="muted" style="margin-top:0.75rem">Submitting prepares a message in your email app — it isn't sent by this site.</p>
      </form>
    </div>
    {{/if}}
    {{> ad-unit adSlot="1234567894"}}
  </div>
</section>
