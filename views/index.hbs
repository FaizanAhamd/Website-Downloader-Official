<!-- ============ HERO + DOWNLOADER ============ -->
<section class="hero" id="home">
  <div class="container hero-inner">

    <div class="hero-copy">
      <span class="badge badge-primary">Public Website Mirroring</span>
      <h1>Mirror Any Public Website. Download It as ZIP.</h1>
      <p class="hero-sub">
        Mirror publicly accessible web pages and their linked resources. Download the
        collected files in one convenient ZIP archive.
      </p>
      <ul class="hero-points">
        <li>Download publicly accessible HTML pages and available assets.</li>
        <li>Save linked resources for offline browsing.</li>
        <li>Package downloaded website files into one ZIP archive.</li>
      </ul>
    </div>

    <div class="downloader-card" id="downloader">
      <div class="card-body">
        <h2 class="card-title">Download a public website</h2>
        <p class="card-sub">Enter the website URL you want to mirror.</p>

        <form id="download-form" novalidate>
          <div class="field">
            <label class="sr-only" for="url-input">Website URL</label>
            <div class="input-group">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <input
                type="url"
                id="url-input"
                name="url"
                placeholder="https://example.com"
                autocomplete="url"
                spellcheck="false"
                aria-describedby="url-error"
                required
              />
            </div>
            <p class="field-error" id="url-error" role="alert" hidden></p>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block" id="download-btn">
            Download Website
          </button>
        </form>

        <p class="input-note">
          Only publicly accessible web pages and resources can be mirrored. Private
          server-side source code and databases cannot be downloaded.
        </p>

        <!-- Connection status -->
        <p class="dl-status" id="conn-status" role="status" hidden></p>

        <!-- Progress (downloading / packaging) -->
        <div class="progress-block" id="progress-block" hidden>
          <div class="progress-track" id="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="Download progress">
            <div class="progress-fill indeterminate" id="progress-bar"></div>
          </div>
          <div class="progress-meta">
            <span class="status-text" id="status-text">Starting…</span>
            <span class="file-count" id="file-count">0 files</span>
          </div>
          <div class="progress-actions">
            <button type="button" class="btn btn-ghost btn-sm" id="cancel-btn" hidden>Cancel Download</button>
          </div>
          <pre class="log" id="log" aria-live="polite" aria-label="Download log"></pre>
        </div>

        <!-- Result (completed) -->
        <div class="result-block" id="result-block" hidden>
          <span class="success-icon" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="M22 4L12 14.01l-3-3" />
            </svg>
          </span>
          <p class="success-msg" id="success-msg">Your ZIP archive is ready.</p>
          <p class="result-files" id="result-files"></p>
          <p class="result-zip" id="zip-name"></p>
          <a class="btn btn-success btn-lg btn-block" id="zip-btn" href="#" download>Download ZIP Archive</a>
          <p class="input-note">The archive is stored temporarily and removed automatically after it is downloaded.</p>
        </div>

        <!-- Error banner -->
        <div class="error-banner" id="error-banner" role="alert" hidden>
          <p class="error-msg" id="error-msg"></p>
          <button type="button" class="btn btn-ghost btn-sm" id="retry-btn">Try again</button>
        </div>
      </div>
    </div>

  </div>
</section>

